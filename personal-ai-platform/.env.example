# =============================================================================
# FILE MẪU - KHÔNG điền key thật vào file này.
# Script scripts\setup.ps1 sẽ tạo file .env (đã bị .gitignore chặn, không lên GitHub).
# =============================================================================

# --- Khóa nội bộ (setup.ps1 tự sinh ngẫu nhiên, không cần tự nghĩ) ---
LITELLM_MASTER_KEY=sk-REPLACE_BY_SETUP
WEBUI_SECRET_KEY=REPLACE_BY_SETUP

# --- API key miễn phí: tự lấy từ trang của từng nhà cung cấp (xem docs/Install.md) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Ollama chạy trên Windows; container gọi qua host.docker.internal ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Đăng ký tài khoản mới ---
# Đặt true CHỈ khi tạo tài khoản admin đầu tiên, sau đó đổi lại false và khởi động lại.
ENABLE_SIGNUP=false

# --- Phiên bản image ---
# Sau khi hệ thống chạy ổn định, nên thay "main" bằng một tag cụ thể để tránh cập nhật bất ngờ.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
